# Resend email API key (get one at resend.com)
RESEND_API_KEY=

# Email to receive contact form submissions
CONTACT_EMAIL=bigsexysbrineco@gmail.com

# Public site URL (used for sitemap, OG tags, etc.)
NEXT_PUBLIC_SITE_URL=https://bigsexysbrine.co

# Supabase (get these from your Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Online ordering (coming soon)
# NEXT_PUBLIC_ settings are sent to the browser, so they hold IDs only, never secrets.
# Square application ID (Square Developer Dashboard, Credentials page)
NEXT_PUBLIC_SQUARE_APPLICATION_ID=your-square-application-id
# Square location ID for the shop that takes the orders
NEXT_PUBLIC_SQUARE_LOCATION_ID=your-square-location-id
# "sandbox" for test payments, "production" for real ones
NEXT_PUBLIC_SQUARE_ENVIRONMENT=sandbox
# Show the cart and Add to Cart buttons even while the store is closed.
# Local preview only, never set in Vercel. Put it in .env.development.local.
# NEXT_PUBLIC_ORDERING_PREVIEW=true

# The settings below are server-only secrets. Never give them a NEXT_PUBLIC_ name.
# Square access token, used by server code to call Square
SQUARE_ACCESS_TOKEN=your-square-access-token
# Square webhook signature key, used to check that order updates really come from Square
SQUARE_WEBHOOK_SIGNATURE_KEY=your-square-webhook-signature-key
# The exact webhook URL registered with Square (part of the signature check)
SQUARE_WEBHOOK_URL=your-square-webhook-url
# OpenRouteService API key, used to find the driving distance for delivery
ORS_API_KEY=your-openrouteservice-api-key
# Pushover app token, used to send new-order alerts to a phone
PUSHOVER_TOKEN=your-pushover-app-token
# Pushover user key: the account that receives the new-order alerts
PUSHOVER_USER=your-pushover-user-key
# Address that receives new-order emails (and the tax rate reminders)
ORDER_ALERT_EMAIL=orders@example.com
# Random secret that Vercel sends with each scheduled job, so only Vercel can run
# the tax rate reminder and the health check (src/app/api/cron/)
CRON_SECRET=any-long-random-string

# Local preview only. Put this in .env.development.local (never in Vercel) to
# fill the admin order pages with made-up orders. It does nothing on the live site.
# ORDERS_DEMO=true
